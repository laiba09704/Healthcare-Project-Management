# MongoDB Atlas Configuration
# Replace with your actual connection string from MongoDB Atlas:
# e.g. mongodb+srv://username:password@cluster0.abcde.mongodb.net/smartcare_pms?retryWrites=true&w=majority

PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smartcare_pms?retryWrites=true&w=majority
